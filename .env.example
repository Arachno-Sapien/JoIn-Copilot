# Backend settings. Copy to .env in the repository root.
# There is no model key here: each user sets their own AI provider (any
# OpenAI-compatible API) and key in the extension options, and the extension
# sends them with each request.
JC_LLM_MODE=live
# Comma-separated provider base URLs this backend may call, for example
# https://api.openai.com/v1,https://openrouter.ai/api/v1. Empty allows any; set it
# on a backend other people can reach.
JC_LLM_BASE_URLS=
JC_EMBED_MODE=model
JC_EMBED_MODEL=BAAI/bge-small-en-v1.5
JC_DB_PATH=data/jobs.sqlite
JC_SCHEDULER=on

# Optional job source, not AI: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Greenhouse board tokens to poll, for example stripe,airbnb
JC_GREENHOUSE_BOARDS=
# Lever company slugs to poll, for example netflix
JC_LEVER_COMPANIES=
# Adzuna search queries (used when ADZUNA_APP_ID and ADZUNA_APP_KEY are set), for example software intern,data analyst
JC_ADZUNA_QUERIES=
# Adzuna two-letter country code (default: in)
JC_ADZUNA_COUNTRY=in
