# Model configuration (e.g. openai/gpt-4o-mini, ollama/llama3, etc.)
JC_LLM_SMALL_MODEL=openai/gpt-4o-mini
JC_LLM_STRONG_MODEL=openai/gpt-4o
JC_LLM_MODE=live
JC_EMBED_MODE=model
JC_EMBED_MODEL=BAAI/bge-small-en-v1.5
JC_DB_PATH=data/jobs.sqlite
JC_SCHEDULER=on

# Provider API Keys (leave blank in example, set in your local .env)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
