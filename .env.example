# Backend settings. Copy to .env in the repository root.
# There is no model key here: each user pastes their own BharatCode key in the
# extension options, and the extension sends it with each request.
JC_LLM_MODE=live
JC_EMBED_MODE=model
JC_EMBED_MODEL=BAAI/bge-small-en-v1.5
JC_DB_PATH=data/jobs.sqlite
JC_SCHEDULER=on

# Optional job source, not AI: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
